# Example secret for GitLab Runner authentication token
#
# This file is for reference only. Create the actual secret using kubectl:
#
#   kubectl create secret generic gitlab-runner-secret \
#     --from-literal=runner-registration-token="" \
#     --from-literal=runner-token='glrt-<YOUR_RUNNER_AUTH_TOKEN>' \
#     -n managed-cicd
#
# Or use the setup script:
#   RUNNER_TOKEN=glrt-xxx ./scripts/runner-setup.sh gitlab

apiVersion: v1
kind: Secret
metadata:
  name: gitlab-runner-secret
  namespace: managed-cicd
type: Opaque
stringData:
  runner-registration-token: ""
  runner-token: "glrt-<YOUR_RUNNER_AUTH_TOKEN>"
